{
  "contract_version": "pdfjs-direct-concept-capture@1.0.0",
  "package": "pdfjs-dist",
  "version": "6.2.108",
  "license": "Apache-2.0",
  "runtime": {
    "self_hosted": true,
    "canvas_rendering": true,
    "selectable_text_layer": true,
    "worker_same_origin": true,
    "cmap_same_origin": true,
    "standard_fonts_same_origin": true,
    "wasm_same_origin": true,
    "external_runtime_dependencies": 0
  },
  "security": {
    "authenticated_pdf_blob": true,
    "credential_in_url": false,
    "xfa_enabled": false,
    "dynamic_evaluation_enabled": false,
    "application_external_api_requests": 0,
    "real_provider_requests": 0,
    "real_credentials_read": false
  },
  "selection_contract": {
    "max_characters": 180,
    "unique_governed_chunk_required": true,
    "omitted_layout_whitespace": "unique_compact_match_only",
    "server_revalidation_required": true,
    "ambiguous_mapping": "fail_closed",
    "unmapped_selection": "fail_closed",
    "fallback": "same_page_governed_parsed_text_only"
  }
}
