# LexiBridge AI production environment template.
# This file intentionally contains placeholders. scripts/check_env.py must fail
# until every placeholder is replaced with real production configuration.

APP_ENV=production
FLASK_ENV=production
DEBUG=false
FLASK_DEBUG=false

SECRET_KEY=replace-with-strong-secret
TOKEN_HASH_SECRET=replace-with-strong-secret
DATABASE_URL=postgresql://user:password@host:5432/lexibridge
DATABASE_ENGINE=postgresql

FRONTEND_ORIGIN=https://your-domain.example
CORS_ALLOW_ORIGINS=https://your-domain.example

AI_PROVIDER=deepseek
AI_PROVIDER_MODE=live
AI_MODEL=deepseek-chat
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ALLOW_MOCK_AI=false
ALLOW_LOCAL_HEURISTIC_AI=false
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=2
AI_DAILY_CALL_LIMIT_PER_USER=100
AI_MONTHLY_CALL_LIMIT_PER_USER=1000
AI_DAILY_COST_LIMIT_PER_USER=5.00
AI_PROVIDER_HEALTHCHECK_ENABLED=true
AI_LOG_PROMPT_FULL=false
AI_LOG_RESPONSE_FULL=false
AI_LOG_REDACT_SECRETS=true

OCR_PROVIDER=tesseract
OCR_LANGS=eng+chi_sim
OCR_MIN_CONFIDENCE=60
PDF_OCR_DPI=300

FORMULA_OCR_PROVIDER=none
MATHPIX_APP_ID=YOUR_MATHPIX_APP_ID_HERE
MATHPIX_APP_KEY=YOUR_MATHPIX_APP_KEY_HERE
LOCAL_LATEX_OCR_COMMAND=

MAX_UPLOAD_MB=25
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/var/lib/lexibridge/uploads
UPLOAD_FOLDER=/var/lib/lexibridge/uploads
DERIVED_UPLOAD_DIR=/var/lib/lexibridge/derived

STORAGE_BACKEND=s3
LOCAL_STORAGE_ROOT=/var/lib/lexibridge/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID_HERE
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY_HERE
S3_REGION=
S3_PUBLIC_BASE_URL=

JOB_WORKER_MODE=local
JOB_MAX_ATTEMPTS=3
JOB_WORKER_QUEUE_MODE=standard
LEGACY_ALIGNMENT_ROUTE_ADMISSION_ENABLED=true
LEGACY_ALIGNMENT_RUNTIME_STATE=active
LEGACY_ALIGNMENT_SAFE_FAILURE_APPLY_ENABLED=false
LEGACY_ALIGNMENT_OBSERVATION_ENABLED=true

LOG_LEVEL=INFO
LOG_JSON=true
LOG_REDACT_SECRETS=true

RETRIEVAL_BACKEND=lexical
RETRIEVAL_VERSION=lexical_v1
ENABLE_VECTOR_SEARCH=false
VECTOR_INDEX_BACKEND=none
VECTOR_INDEX_DIR=/var/lib/lexibridge/vector_indexes
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_SECONDS=45
ENABLE_HYBRID_SEARCH=false
HYBRID_LEXICAL_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.45
HYBRID_MIN_LEXICAL_GATE=0.20
HYBRID_MIN_FINAL_SCORE=0.65
RERANKER_PROVIDER=none
ENABLE_RERANKER=false
RERANKER_TOP_K=20
RERANKER_FINAL_K=5
VECTOR_SEARCH_TOP_K=20
LEXICAL_SEARCH_TOP_K=20
FINAL_EVIDENCE_TOP_K=5

AUTH_REQUIRED=true
ENABLE_MOCK_PAYMENT=false
ENABLE_MOCK_EMAIL=false
MOCK_PAYMENT_ENABLED=false
MOCK_EMAIL_ENABLED=false
