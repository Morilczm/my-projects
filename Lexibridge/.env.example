# LexiBridge AI common environment template.
# Copy to .env for local development. Do not commit real secrets.

APP_ENV=development
FLASK_ENV=development
DEBUG=true
FLASK_DEBUG=true

SECRET_KEY=change-me-in-local-dev
TOKEN_HASH_SECRET=change-me-in-local-token-hash-secret

DATABASE_URL=sqlite:///lexibridge.db
DATABASE_ENGINE=sqlite

BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
FRONTEND_ORIGIN=http://localhost:5000
CORS_ALLOW_ORIGINS=http://localhost:5000

AI_PROVIDER=none
AI_MODEL=
AI_PROVIDER_MODE=none
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ALLOW_MOCK_AI=true
ALLOW_LOCAL_HEURISTIC_AI=true

# TRANSLATION_PROVIDER: none | ollama | auto（auto 按 TRANSLATION_PROVIDER_CHAIN 顺序尝试）
TRANSLATION_PROVIDER=none
# TRANSLATION_PROVIDER_CHAIN=ollama
# TRANSLATION_GLOSSARY_MAX_ENTRIES=25
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=translategemma:12b
TRANSLATION_TIMEOUT_SECONDS=30

AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=2
AI_DAILY_CALL_LIMIT_PER_USER=100
AI_MONTHLY_CALL_LIMIT_PER_USER=1000
AI_DAILY_COST_LIMIT_PER_USER=5.00
AI_PROVIDER_HEALTHCHECK_ENABLED=true
AI_LOG_PROMPT_FULL=false
AI_LOG_RESPONSE_FULL=false
AI_LOG_REDACT_SECRETS=true

OCR_PROVIDER=none
OCR_LANGS=eng+chi_sim
OCR_MIN_CONFIDENCE=60
OCR_ENABLE_REGION_EXTRACTION=true
PDF_OCR_DPI=300
PDF_IMAGE_MIN_WIDTH=80
PDF_IMAGE_MIN_HEIGHT=40
PDF_MIXED_PAGE_IMAGE_OCR=true

# LAYOUT_PROVIDER=rule_based
# LAYOUT_MODEL_PATH=/path/to/doclayout_yolo_docstructbench_imgsz1024.onnx
# LAYOUT_MODEL_SCORE_THRESHOLD=0.25
# LAYOUT_MODEL_NMS_IOU_THRESHOLD=0.45
# Optional governed Docling route. This is intentionally opt-in and uses a
# separately provisioned offline runtime; simple digital PDFs remain native.
# LAYOUT_PROVIDER=conditional_docling
# DOCLING_PARSER_PYTHON=/absolute/path/to/isolated-docling/bin/python
# DOCLING_MODEL_ROOT=/absolute/path/to/preprovisioned/docling-models
# DOCLING_PARSER_TIMEOUT_SECONDS=120
# DOCLING_PARSER_MAX_FILE_BYTES=52428800
# DOCLING_PARSER_MAX_PAGES=50
# DOCLING_PARSER_MAX_OUTPUT_BYTES=16777216

FORMULA_OCR_PROVIDER=none
FORMULA_OCR_MIN_CONFIDENCE=60
FORMULA_DETECTION_MODE=heuristic
MATHPIX_APP_ID=YOUR_MATHPIX_APP_ID_HERE
MATHPIX_APP_KEY=YOUR_MATHPIX_APP_KEY_HERE
LOCAL_LATEX_OCR_COMMAND=

MAX_UPLOAD_MB=25
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=uploads
UPLOAD_FOLDER=backend/uploads
DERIVED_UPLOAD_DIR=uploads/derived

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=backend/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID_HERE
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY_HERE
S3_REGION=
S3_PUBLIC_BASE_URL=

JOB_WORKER_MODE=local
JOB_WORKER_ID=local-worker
JOB_MAX_ATTEMPTS=3
JOB_WORKER_QUEUE_MODE=standard
LEGACY_ALIGNMENT_ROUTE_ADMISSION_ENABLED=true
LEGACY_ALIGNMENT_RUNTIME_STATE=active
LEGACY_ALIGNMENT_SAFE_FAILURE_APPLY_ENABLED=false
LEGACY_ALIGNMENT_OBSERVATION_ENABLED=true

LOG_LEVEL=INFO
LOG_JSON=false
LOG_REDACT_SECRETS=true

AUTH_REQUIRED=true
ENABLE_MOCK_PAYMENT=true
ENABLE_MOCK_EMAIL=true
MOCK_PAYMENT_ENABLED=true
MOCK_EMAIL_ENABLED=true

LOCAL_EMBEDDING_DIM=256
MIN_RETRIEVAL_SCORE=65
RETRIEVAL_BACKEND=lexical
RETRIEVAL_VERSION=lexical_v1
ENABLE_VECTOR_SEARCH=false
VECTOR_INDEX_BACKEND=none
VECTOR_INDEX_DIR=data/vector_indexes
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_SECONDS=45
ENABLE_HYBRID_SEARCH=false
HYBRID_LEXICAL_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.45
HYBRID_MIN_LEXICAL_GATE=0.20
HYBRID_MIN_FINAL_SCORE=0.65
RERANKER_PROVIDER=none
ENABLE_RERANKER=false
RERANKER_TOP_K=20
RERANKER_FINAL_K=5
RERANKER_REQUEST_TIMEOUT_SECONDS=45
VECTOR_SEARCH_TOP_K=20
LEXICAL_SEARCH_TOP_K=20
FINAL_EVIDENCE_TOP_K=5
RETRIEVAL_EXPERIMENT_OUTPUT_DIR=docs/generated/retrieval_experiments
TERM_EXTRACTION_PROMPT_VERSION=term_extraction_v1
ALIGNMENT_PROMPT_VERSION=alignment_v1

RUN_PACKAGE_TESTS=1
