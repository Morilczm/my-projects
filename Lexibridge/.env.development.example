# LexiBridge AI development environment.
# Intended for local development, demos, and Codex validation.

APP_ENV=development
FLASK_ENV=development
DEBUG=true
FLASK_DEBUG=true

SECRET_KEY=change-me-in-local-dev
DATABASE_URL=sqlite:///lexibridge_dev.db
DATABASE_ENGINE=sqlite

FRONTEND_ORIGIN=http://localhost:5000
CORS_ALLOW_ORIGINS=http://localhost:5000

AI_PROVIDER=none
AI_PROVIDER_MODE=none
AI_MODEL=
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ALLOW_MOCK_AI=true
ALLOW_LOCAL_HEURISTIC_AI=true
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=2
AI_DAILY_CALL_LIMIT_PER_USER=100
AI_MONTHLY_CALL_LIMIT_PER_USER=1000
AI_DAILY_COST_LIMIT_PER_USER=5.00
AI_PROVIDER_HEALTHCHECK_ENABLED=true
AI_LOG_PROMPT_FULL=false
AI_LOG_RESPONSE_FULL=false
AI_LOG_REDACT_SECRETS=true

OCR_PROVIDER=none
OCR_LANGS=eng+chi_sim
FORMULA_OCR_PROVIDER=none

MAX_UPLOAD_MB=25
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=uploads
UPLOAD_FOLDER=backend/uploads
DERIVED_UPLOAD_DIR=uploads/derived

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=backend/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID_HERE
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY_HERE
S3_REGION=
S3_PUBLIC_BASE_URL=

JOB_WORKER_MODE=local
JOB_MAX_ATTEMPTS=3
JOB_WORKER_QUEUE_MODE=standard
LEGACY_ALIGNMENT_ROUTE_ADMISSION_ENABLED=true
LEGACY_ALIGNMENT_RUNTIME_STATE=active
LEGACY_ALIGNMENT_SAFE_FAILURE_APPLY_ENABLED=false
LEGACY_ALIGNMENT_OBSERVATION_ENABLED=true

LOG_LEVEL=INFO
LOG_JSON=false
LOG_REDACT_SECRETS=true

RETRIEVAL_BACKEND=lexical
RETRIEVAL_VERSION=lexical_v1
ENABLE_VECTOR_SEARCH=false
VECTOR_INDEX_BACKEND=none
VECTOR_INDEX_DIR=data/vector_indexes
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=32
ENABLE_HYBRID_SEARCH=false
HYBRID_LEXICAL_WEIGHT=0.55
HYBRID_VECTOR_WEIGHT=0.45
HYBRID_MIN_LEXICAL_GATE=0.20
RERANKER_PROVIDER=none
ENABLE_RERANKER=false
VECTOR_SEARCH_TOP_K=20
LEXICAL_SEARCH_TOP_K=20
FINAL_EVIDENCE_TOP_K=5

ENABLE_MOCK_PAYMENT=true
ENABLE_MOCK_EMAIL=true
MOCK_PAYMENT_ENABLED=true
MOCK_EMAIL_ENABLED=true
