.faq-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
  padding: 30rpx;
  box-sizing: border-box;
}

.faq-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.faq-header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.faq-header-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.faq-category {
  margin-bottom: 30rpx;
}

.category-title {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.category-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.category-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3748;
}

.faq-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
}

.question-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #2d3748;
  flex: 1;
}

.question-arrow {
  font-size: 20rpx;
  color: #a0aec0;
  transition: transform 0.3s ease;
}

.question-arrow.expanded {
  transform: rotate(180deg);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
  background: #f7fafc;
}

.faq-answer.show {
  max-height: 1000rpx;
  padding: 24rpx;
}

.answer-text {
  font-size: 26rpx;
  color: #4a5568;
  line-height: 1.8;
  white-space: pre-wrap;
}

.faq-contact {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  margin-top: 40rpx;
}

.contact-title {
  display: block;
  font-size: 28rpx;
  color: #718096;
  margin-bottom: 30rpx;
}

.contact-buttons {
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.contact-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 50rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.contact-btn:active {
  transform: scale(0.95);
}

.contact-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.contact-text {
  font-size: 24rpx;
  color: #fff;
}